# Install ChEMBL web service package to retrieve bioactivity data from ChEMBL Database
! pip install chembl_webresource_client

# Import libraries
import pandas as pd
from chembl_webresource_client.new_client import new_client

# Target search changing (' ') to target
target = new_client.target
target_query = target.search('coronavirus') 
targets = pd.DataFrame.from_dict(target_query)
targets

# Select and retrieve bioactivity data by entry # [ ]
selected_target = targets.target_chembl_id[10] 
selected_target

# Retrieve bioactivity data reported as IC50 values in nM 
activity = new_client.activity
res = activity.filter(target_chembl_id=selected_target).filter(standard_type="IC50")
df = pd.DataFrame.from_dict(res)
df.head(3)
df.to_csv('bioactivity_data.csv', index=False)

# Drop compounds with missing value for standard_value column
df2 = df[df.standard_value.notna()]
df2

# Label compounds active (<1,000), inactive(>10,000), or intermediate (1,000 - 10,000)
bioactivity_class = []
for i in df2.standard_value:
  if float(i) >= 10000:
    bioactivity_class.append("inactive")
  elif float(i) <= 1000:
    bioactivity_class.append("active")
  else:
    bioactivity_class.append("intermediate")

# Combine 3 columns (molecule_chembl_id, canonical_smiles, standard_value) and bioactivity_class into a dataframe
selection = ['molecule_chembl_id', 'canonical_smiles', 'standard_value']
df3 = df2[selection]
df3
pd.concat([df3,pd.Series(bioactivity_class)], axis=1)

bioactivity_class = pd.Series(bioactivity_class, name='bioactivity_class')
df4 = pd.concat([df3, bioactivity_class], axis=1)
df4

# Save dataframe to CSV file
df4.to_csv('bioactivity_data_preprocessed.csv', index=False)
